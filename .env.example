# انسخه إلى .env وضع توكن BotFather
BOT_TOKEN=
# اختياري — كل هذه تُعدَّل لاحقًا من لوحة /admin داخل تليجرام (الإعدادات)
TIMER_SECONDS=30        # 0 = بدون مؤقت
COOLDOWN_MINUTES=30     # الانتظار بين اختبارين كاملين، 0 = بدون
REQUIRED_CHANNEL=@Anime1Galaxy   # اشتراك إجباري (البوت لازم يكون أدمن بالقناة)، فارغ = تعطيل
# المالك: الأسهل أن تشغّل البوت وتنسخ «كود التفعيل» من السجل وترسله له /claim الكود.
# أو ضع رقمك هنا (تعرفه من /myid) — أرقام مفصولة بفاصلة:
ADMIN_IDS=
# DB_PATH=otaku.db
# FONT_PATH=assets/font.ttf   # خط يدعم العربية لبطاقة النتيجة
